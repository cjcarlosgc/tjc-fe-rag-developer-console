# RAG Core API local (tjc-be-rag-core-api/app, PORT=3000). El navegador nunca
# habla directamente con el Sandbox (PORT=3001 en ese repo); Core es quien lo
# hace, usando su propio SANDBOX_URL/SANDBOX_SERVICE_TOKEN.
VITE_CORE_API_URL=http://localhost:3000
# Opcional: sin definir, `vite dev` usa mock y los builds de producción usan live
# (por eso no hace falta en Render).
VITE_DATA_SOURCE=mock

# HU29 — identidad. Opcional: sin definir se deriva de VITE_DATA_SOURCE
# (live → supabase, mock → mock). mock solo es
# válido junto con VITE_DATA_SOURCE=mock; la combinación mock+live queda
# bloqueada en tiempo de ejecución (AuthProvider).
VITE_AUTH_MODE=mock
# Solo se usan cuando VITE_AUTH_MODE=supabase; sin proyecto Supabase real
# todavía, este adapter no se prueba en vivo (ver harness/reports).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
