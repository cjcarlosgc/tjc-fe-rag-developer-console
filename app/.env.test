# Vite/Vitest siempre cargan `.env` además de `.env.[mode]`. Sin este archivo,
# un `.env` local que fije VITE_DATA_SOURCE/VITE_AUTH_MODE explícitamente
# (p. ej. VITE_DATA_SOURCE=mock para desarrollo) pisa el valor por defecto que
# los tests esperan en modo test (dataSource.ts/authMode.ts: `live`/`supabase`
# cuando la variable no está seteada). Vacías aquí para que el modo test sea
# determinista y no dependa del `.env` de cada quien.
VITE_DATA_SOURCE=
VITE_AUTH_MODE=
